-- The Ackermann function, summed over a few inputs to land in the time window.
--
-- STRESSES: very deep, non-tail recursion and nested closure application. Unlike
-- fib's shallow tree, ack drives the reducer's explicit-stack spine to large
-- depth and exercises the closure-apply hook (Runtime.applyClosure) relentlessly.
-- Numeric conditionals (if) and currying dominate; little allocation of compound
-- data.
--
-- A classic recursion benchmark.
import core, list, math in
let
	ack = m -> n -> [m,n] > {
		[0,n] -> succ n,
		[m,0] -> ack (pred m) 1,
		[m,n] -> ack (pred m) (ack m (pred n))
	}
in
range 5 8 > map (ack 3) > sum > show
