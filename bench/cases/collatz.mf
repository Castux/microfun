-- Total Collatz stopping time summed over 1..15000.
--
-- STRESSES: integer arithmetic builtins (div, mul, mod, add) and conditional
-- branching driven from user code, with a recursive per-number loop. A mix of
-- builtin calls and closure dispatch that resembles real numeric code rather
-- than a microbenchmark.
--
-- A common, useful computation. The outer `sum (map len …)` keeps the forced
-- thunk depth at the list length (15000), well under the deep-recursion ceiling.
import core, list, math in
let
  step = n -> if (even n) (div 2 n) (add 1 (mul 3 n)),
  len  = n -> if (lte 1 n) 0 (add 1 (len (step n)))
in
show (sum (map len (range 1 15000)))
