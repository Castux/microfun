-- Naive doubly-recursive Fibonacci.
--
-- STRESSES: raw β-reduction throughput plus number-literal pattern matching.
-- Every call dispatches a 3-clause multi-lambda (two number patterns + a
-- catch-all) and recurses twice, so the program is almost pure
-- closure-application and matcher work — exactly the two AST walks the compiled
-- backend replaces (IMPLEMENTATION.md §16, BYTECODE.md §2). Shallow recursion
-- depth (~n), so no deep-thunk forcing.
--
-- A common, well-known algorithm; also a clean apples-to-apples dispatch test.
import core, math in
let fib = {
  0 -> 0,
  1 -> 1,
  n -> add (fib < sub 1 n) (fib < sub 2 n)
} in
show (fib 32)
