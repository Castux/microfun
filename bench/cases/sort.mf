-- Quicksort (stdlib list.sort) of a large pseudo-random list.
--
-- STRESSES: heavy compound-data allocation (cons cells churned by the
-- partition/concat in quicksort), comparison closures applied per element, and
-- cross-module references into `list`/`math` — i.e. the module-environment
-- lookups footnoted for link-patching in BYTECODE.md §15.2. This is the kind of
-- allocation-bound workload a future direct-reduction machine (§15.1) would
-- speed up most.
--
-- A common, useful algorithm on real-ish data. The LCG keeps the input
-- reproducible; `sum` forces the whole sorted spine.
import core, list, math in
let
  randomNext = n -> mod 100000 (add 1013904223 (mul 1664525 n)),
  data       = take 9000 (iterate randomNext 1)
in
show (sum (sort data))
