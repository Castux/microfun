-- heap.mf: purely functional leftist heaps.
-- Provides O(log n) insert, merge, and pop.
-- This is a max-priority heap: the root is the element that "wins" the comparison.
-- Node structure: [rank, value, left, right]
-- where rank is the length of the right spine (the shortest path to an empty node).
import core, math, list in

module

empty = [], -- the empty heap

isEmpty = { [] -> 1, h -> 0 }, -- 1 if heap is empty, else 0

singleton = value -> [1, value, [], []], -- a heap containing only one value

rankOf = { [] -> 0, [rank, value, left, right] -> rank }, -- shortest path to an empty node

-- makeNode value left right: internal helper to maintain leftist property (right rank <= left rank)
makeNode = value -> left -> right ->
	let
		rankLeft  = rankOf left,
		rankRight = rankOf right
	in
		if (gte rankRight rankLeft)
			[succ rankRight, value, left, right]
			[succ rankLeft, value, right, left],

-- merge comparator h1 h2: merge two heaps ($O(\log n)$)
merge = comparator -> {
	[] -> h2 -> h2,
	[rank1, value1, left1, right1] -> {
		[] -> [rank1, value1, left1, right1],
		[rank2, value2, left2, right2] ->
			if (comparator value1 value2)
				(makeNode value1 left1 (merge comparator right1 [rank2, value2, left2, right2]))
				(makeNode value2 left2 (merge comparator [rank1, value1, left1, right1] right2))
	}
},

insert = comparator -> x -> h -> merge comparator (singleton x) h, -- insert x into heap h ($O(\log n)$)

peek = {
	[] -> [],
	[rank, value, left, right] -> value
}, -- return the root value of the heap ($O(1)$)

pop = comparator -> {
	[] -> [],
	[rank, value, left, right] -> merge comparator left right
}, -- remove the root and return the new heap ($O(\log n)$)

fromList = comparator -> foldl (h -> x -> insert comparator x h) [], -- build a heap from a list

toList = comparator -> {
	[] -> [],
	h -> [peek h, toList comparator (pop comparator h)]
}, -- convert a heap to a sorted list (heapsort)

-- sort comparator l: Heapsort using the provided comparator.
sort = comparator -> l -> toList comparator (fromList comparator l)

