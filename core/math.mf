-- math.mf: numeric operations.
-- Imports core for `if`, which is used throughout.
import core, list in

module

-- builtin: add, mul, sub, div, fdiv, mod, fmod, sqrt, eq, lt, lte, gte, gt, neq

succ = add 1,
pred = sub 1,
minus = n -> sub n 0,
negate = minus,
signum = n -> if (eq n 0) 0 (if (lt 0 n) (minus 1) 1),
abs = n -> if (lt 0 n) (minus n) n,
max = a -> b -> if (lt a b) a b,
min = a -> b -> if (lt a b) b a,
clamp = lo -> hi -> n -> max lo (min hi n),

-- trunc rounds towards zero (identical to integer division by 1)
trunc = div 1,

floor = n ->
	let t = trunc n in
	if (lt 0 n)
		(if (eq t n) t (sub 1 t))
		t,

ceil = n ->
	let t = trunc n in
	if (lt 0 n)
		t
		(if (eq t n) t (add 1 t)),

-- rounds half up: round (-2.5) = -2
round = n -> floor (add 0.5 n),

-- pow exp base = base ^ exp  (non-negative integer exponents only)
pow = exp -> base ->
	if (eq exp 0)
		1
		(mul base (pow (sub 1 exp) base)),

even = n -> eq 0 (mod 2 n),
odd  = n -> eq 1 (mod 2 n),

gcd = a -> b ->
	let
		absA = abs a,
		absB = abs b,
		go = {
			[x, 0] -> x,
			[x, y] -> go [y, mod y x]
		}
	in
		go [absA, absB],

lcm = a -> b ->
	if (or (eq a 0) (eq b 0))
		0
		(abs (mul (div (gcd a b) b) a)),

digits = {
	0 -> [0;],
	n -> (n > iterate (div 10) > takeWhile (gt 0) > map (mod 10) > reverse)
}
