module

some = x -> [x],
none = [],

isSome = {
	[x] -> 1,
	_ -> 0
},

isNone = {
	[] -> 1,
	_ -> 0
},

isMaybe = {
	[] -> 1,
	[x] -> 1,
	_ -> 0
},

fmap = f -> {
	[] -> [],
	[x] -> [f x]
},

-- bind f m: monadic bind — apply f to the wrapped value; propagate none.
-- f must return a maybe value.
bind = f -> {
	[] -> [],
	[x] -> f x
},

value = [x] -> x,

default = def -> {
	[] -> def,
	[x] -> x
},

-- orElse other m: return m if it is some, otherwise other.
orElse = other -> {
	[] -> other,
	[x] -> [x]
},

-- mapDefault def f m: apply f to the wrapped value, or return def if none.
mapDefault = def -> f -> {
	[] -> def,
	[x] -> f x
}
