-- text.mf: string formatting, parsing, and value rendering.
-- Strings in microfun are lists of Unicode code points, so all list operations
-- work on them directly. This module adds higher-level formatting utilities.
import list, math, core in

module

-- char s: code point of the first (or only) character of string s
char = head, -- extract the first code point of a string

-- Named code points for characters that cannot appear in string literals
nul       = 0,   -- \0  null
tab       = 9,   -- \t  horizontal tab
lf        = 10,  -- \n  line feed (newline on Unix)
cr        = 13,  -- \r  carriage return
esc       = 27,  -- \e  escape
space     = 32,  --     space
dquote    = 34,  -- \"  double quote
quote     = 39,  -- \'  single quote (string delimiter in microfun)
backslash = 92,  -- \\  backslash

-- join separator strings: intercalate separator between each string in the list
join = separator -> {
	[] -> [],
	[h,t] -> t > {
		[] -> h,
		t2 -> concat h (concat separator (join separator t2))
	}
},

-- padLeft n fill s: left-pad string s with single-char string fill to minimum width n
padLeft = n -> fill -> s -> let
	padLen = n > sub (length s) > max 0
in
	concat
		(flatten (replicate padLen fill))
		s,

-- trim s: remove leading and trailing whitespace from string s
trim = s -> dropWhile isSpace (reverse (dropWhile isSpace (reverse s))),

-- intToString n: render an integer as a string.
-- Produces wrong output for non-integers; use floatToString for fractional numbers.
intToString = n -> let
	sign = if (lt 0 n) '-' '',
	digs = abs n > digits > map intToDigit
in
	concat sign digs,

-- floatToString precision n: render n with exactly `precision` decimal digits.
-- Explicit precision is required; the appropriate number of digits is context-dependent.
floatToString = precision -> n ->
	let
		sign  = if (lt 0 n) '-' '',
		absN  = abs n,
		whole = trunc absN,
		scale = pow precision 10,
		frac  = absN > sub whole > mul scale > trunc
	in
		if (eq precision 0)
			(concat sign (intToString whole))
			(flatten [sign; intToString whole; '.'; padLeft precision '0' (intToString frac)]),

numberToString = n -> if (isInteger n) (intToString n) (floatToString 6 n),

-- toString x: render any number, list, or tuple as a code-point string, ready for `write`.
-- Tuples with more than 10 elements are not supported and will produce a runtime error.
toString =
	let
		tupleToList = {
			[] -> [],
			[a] -> [a;],
			[a,b] -> [a;b],
			[a,b,c] -> [a;b;c],
			[a,b,c,d] -> [a;b;c;d],
			[a,b,c,d,e] -> [a;b;c;d;e],
			[a,b,c,d,e,f] -> [a;b;c;d;e;f],
			[a,b,c,d,e,f,g] -> [a;b;c;d;e;f;g],
			[a,b,c,d,e,f,g,h] -> [a;b;c;d;e;f;g;h],
			[a,b,c,d,e,f,g,h,i] -> [a;b;c;d;e;f;g;h;i],
			[a,b,c,d,e,f,g,h,i,j] -> [a;b;c;d;e;f;g;h;i;j],
			n -> n
		},

		listToString = {
			[x;] -> flatten ['['; toString x; ';]'],
			l -> flatten ['[' ; l > map toString > join '; ' ; ']']
		},

		tupleToString = t ->
			let
				asList = tupleToList t
			in
				if (isList asList)
					(flatten ['[' ; asList > map toString > join ', ' ; ']'])
					(numberToString asList)
	in
		x -> if (isList x) (listToString x) (tupleToString x),

-- Character classification — all functions take a Unicode code point (integer)

isDigit    = c -> and (lte c (char '0')) (lte (char '9') c), -- 1 if c is a digit
isLower    = c -> and (lte c (char 'a')) (lte (char 'z') c), -- 1 if c is lowercase
isUpper    = c -> and (lte c (char 'A')) (lte (char 'Z') c), -- 1 if c is uppercase
isAlpha    = c -> or (isLower c) (isUpper c), -- 1 if c is a letter
isAlphaNum = c -> or (isAlpha c) (isDigit c), -- 1 if c is a letter or digit
isSpace    = c -> eq c space > or (eq c tab) > or (eq c lf) > or (eq c cr), -- 1 if c is whitespace

-- Character conversion
digitToInt = c -> sub (char '0') c, -- convert digit character to its numeric value
intToDigit = n -> add (char '0') n, -- convert numeric value to its digit character
toLower    = c -> if (isUpper c) (add (sub (char 'A') (char 'a')) c) c, -- convert to lowercase
toUpper    = c -> if (isLower c) (sub (sub (char 'A') (char 'a')) c) c, -- convert to uppercase

stringToLower = map toLower, -- convert a whole string to lowercase
stringToUpper = map toUpper, -- convert a whole string to uppercase

-- stringToInt s: parse a decimal integer string (optional leading '-') as a number.
-- No validation; non-digit characters produce wrong results.

parsePositive = foldl (acc -> c -> add (mul 10 acc) (digitToInt c)) 0,

stringToInt = {
	[] -> 0,
	[c, rest] -> if (eq c < char '-') (negate (parsePositive rest)) (parsePositive [c, rest])
},

-- startsWith prefix s: 1 if string s begins with prefix, else 0
startsWith = prefix -> s -> equal prefix (take (length prefix) s),

-- endsWith suffix s: 1 if string s ends with suffix, else 0
endsWith = suffix -> s -> let lenS = length s, lenP = length suffix in equal suffix (drop (sub lenP lenS) s),

-- stringToFloat s: parse a decimal float string (optional leading '-', optional '.').
-- No validation; non-digit/non-dot characters produce wrong results.
stringToFloat = s ->
	let
		zero         = char '0',
		neg          = char '-',
		dot          = char '.',
		parseFrac    = s -> parsePositive s > times (length s) (fdiv 10),
		parseUnsigned = span (c -> neq c dot) *> {
				[intPart, []]        -> parsePositive intPart,
				[intPart, [d, frac]] -> add (parsePositive intPart) (parseFrac frac)
			}
	in
		s > {
			[] -> 0,
			[c, rest] -> if (eq c neg)
				(negate < parseUnsigned rest)
				(parseUnsigned s)
		},

-- split sep s: split string s on separator sep, returning a list of strings.
-- Consecutive separators produce empty strings. Empty sep splits into single-char strings.
split = sep -> s ->
	if (isEmpty sep)
		(map (c -> [c;]) s)
		(let
			sepLen = length sep,
			go     = current -> str ->
				if (equal sep (take sepLen str))
					[reverse current, go [] (drop sepLen str)]
					(str > {
						[] -> [reverse current;],
						[c, rest] -> go [c, current] rest
					})
		in
			go [] s)
