-- countdown.mf
--
-- The numbers round of the Countdown game: starting from a set of source
-- numbers, reach a target by combining them with + - * /, using each number at
-- most once and only ever producing positive whole numbers.
--
-- A node is a little expression tree [value, symbol, left, right]; a source
-- number is a leaf [n, 'given', [], []].
--
-- Strategy. Every expression is a binary tree whose leaves are some subset of
-- the source numbers. We build each tree exactly once by structural recursion:
-- to evaluate a subset, split it into an ordered pair of non-empty subsets,
-- take every result for each side, and combine the two with each operation.
--
-- Three things keep this fast:
--   * each tree is produced once -- it is the unique ordered partition of its
--     leaves, so there are no build-order duplicates to weed out afterwards;
--   * operations are emitted only in canonical, legal form -- '+' and '*' in a
--     single orientation (so a+b and b+a don't both appear), '-' only when it
--     stays positive, '/' only when it divides evenly and is not a trivial ÷1;
--   * a subset is a part of many larger ones, so its results are memoised: the
--     subsets are processed smallest-first and each one's results are bound to
--     a name (which the interpreter shares) and forced once, so every superset
--     reads them back instead of rebuilding them.
--
-- The earlier version assembled solutions by repeatedly combining a pair of
-- numbers and recursing, which produced every tree in many build orders and
-- leaned on a slow final pass to remove the flood of duplicates.

import list, core, text, comb in

let
	target  = 800,
	numbers = [100; 25; 3; 2; 4; 7],

	-- Node accessors -------------------------------------------------------

	leaf  = n -> [n, 'given', [], []],
	value = [v, sym, left, right] -> v,

	-- Combine one left result with one right result into the nodes for each
	-- legal operation. Both orderings of every partition are generated, so a
	-- node is emitted only in its canonical, legal form: + and * only when
	-- right <= left (so a+b and b+a don't both appear), - only when it stays
	-- positive, and / only when it divides evenly and is not a trivial ÷1.
	-- (Recall the builtins lte/gt compare their second argument to the first.)

	combineNodes = left -> right ->
		let lv = value left, rv = value right in
			flatten [
				if (lte lv rv)                                 [ [add lv rv, '+', left, right]; ] [];
				if (and (gt 1 lv) (and (gt 1 rv) (lte lv rv))) [ [mul lv rv, '*', left, right]; ] [];
				if (gt rv lv)                                  [ [sub rv lv, '-', left, right]; ] [];
				if (and (gt 1 rv) (eq 0 (mod rv lv)))          [ [div rv lv, '/', left, right]; ] []
			],

	-- Every left result against every right result.

	combine = lefts -> rights ->
		lefts
			> map (left -> rights > map (combineNodes left) > flatten)
			> flatten,

	-- Subsets and partitions ----------------------------------------------

	-- Every assignment of the elements to a [left, right] pair, then those
	-- where both sides are non-empty: the ordered partitions of the subset.
	-- Both orderings of each partition appear, which is what lets the ops
	-- above pick the legal orientation for - and / and the canonical one for
	-- + and *.

	assignments = {
		[] -> [ [[], []]; ],
		[h, t] -> assignments t
			> map ([l, r] -> [ [[h, l], r]; [l, [h, r]] ])
			> flatten
	},

	partitionsOf = subset ->
		assignments subset > filter ([l, r] -> and (not (empty l)) (not (empty r))),

	-- Memoised results -----------------------------------------------------
	--
	-- The same subset is a part of many larger ones, so its results must be
	-- computed once and shared, not recomputed per use. The interpreter only
	-- shares a value through a binding's thunk, so we build a memo bottom-up:
	-- for each subset (smallest first, so every part is ready) we bind its
	-- results to a name and store that name. eval forces the list to normal
	-- form on first use, so later uses read it back rather than rebuilding it.

	lookup = subset -> {
		[[s, res], rest] -> if (equal subset s) res (lookup subset rest),
		[] -> []
	},

	resultsFor = memo -> {
		[x;] -> [ leaf x; ],
		subset -> partitionsOf subset
			> map ([l, r] -> combine (lookup l memo) (lookup r memo))
			> flatten
	},

	-- Fold the size-ordered subsets into a memo of [subset, results] pairs

	addSubset = memo -> subset ->
		let
			results = resultsFor memo subset
		in
			[[subset, results], memo],

	bySize = a -> b -> lt (length a) (length b),

	memo = subsets numbers
		> filter (not <* empty)
		> sortWith bySize
		> foldl addSubset [],

	-- Solutions ------------------------------------------------------------
	--
	-- Every result of every subset that lands on the target.

	solutionNodes = memo
		> map ([subset, res] -> res)
		> flatten
		> filter (node -> eq target (value node)),

	-- Flatten a solution tree into its internal (operation) nodes, post-order.

	collect = [v, sym, left, right] ->
		if (empty left)
			[]
			(flatten [ collect left; collect right; [ [v, sym, left, right]; ] ]),

	-- Render a solution tree as "a op b = c, …".

	solutionToString = tree ->
		tree
			> collect
			> map ([v, sym, left, right] ->
				join '' [ toString < value left; sym; toString < value right; '='; toString v ])
			> join ', ',

	-- Drop duplicate solution strings, keeping the first occurrence. Two
	-- different trees can print the same line when a sub-expression equals a
	-- source number (e.g. 25*4 and 100), so a light final pass still helps;
	-- by now the list is the real solutions, not a sea of duplicates.

	unique =
		let
			addIfUnique = elem -> seen -> if (contains elem seen) seen [elem, seen]
		in
			foldr addIfUnique [],

	-- Comparator for sortWith: shortest solutions first.

	byLength = a -> b -> lt (length a) (length b),

	solutions = solutionNodes
		> map solutionToString
		> unique
		> sortWith byLength,

	header = join '' [ 'reaching '; toString target; ' from '; toString numbers ],
	footer = join '' [ toString (length solutions); ' solution(s)' ],

	report = concat [ header; ] (concat solutions [ footer; ])
in
	report > map write > eval
