{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "microfun",
  "scopeName": "source.mf",
  "fileTypes": ["mf"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string_double" },
    { "include": "#string_single" },
    { "include": "#keyword" },
    { "include": "#builtin" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#qualified_name" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-dash.mf",
      "match": "--.*$"
    },
    "string_double": {
      "name": "string.quoted.double.mf",
      "begin": "\"",
      "end": "\"",
      "patterns": []
    },
    "string_single": {
      "name": "string.quoted.single.mf",
      "begin": "'",
      "end": "'",
      "patterns": []
    },
    "keyword": {
      "name": "keyword.control.mf",
      "match": "\\b(let|in|module|import)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.mf",
      "match": "\\b(add|mul|sub|div|fdiv|mod|fmod|pow|sqrt|eq|lt|lte|gte|gt|neq|equal|eval|peek|show|write|bwrite|stdin|bstdin)\\b"
    },
    "number": {
      "name": "constant.numeric.mf",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },
    "operator": {
      "name": "keyword.operator.mf",
      "match": "->|<\\*|\\*>|[><=,;.]"
    },
    "qualified_name": {
      "name": "meta.qualified-name.mf",
      "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.namespace.mf" },
        "2": { "name": "variable.other.member.mf" }
      }
    }
  }
}
