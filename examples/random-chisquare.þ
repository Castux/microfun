import core, list, hashmap, math in

let
	N = 100000,
	bins = 20,
	seed = "the super seed",
	incrCount = val -> updateOr val succ 1,
	randomNums = hash seed > iterate hash > map (mod bins) > take N,
	counts = randomNums > foldr incrCount hashmap.empty,

	expected = N > fdiv bins,
	chiSquare = counts > values > map (sub expected *> pow 2 *> fdiv expected) > sum,

	dfs = pred bins,
	approxThreshold = let
		tmp = 2 > fdiv 9 > fdiv dfs
	in
		1 > sub tmp > add (mul 1.645 (sqrt tmp)) > pow 3 > mul dfs,

	report = [
		counts > keyValues > sortWith (on lt first) > string;
		prepend "chi^2: " (string chiSquare);
		prepend "threshold for 5% significance: ~" (string approxThreshold)
	]
in
	report > map write > eval
