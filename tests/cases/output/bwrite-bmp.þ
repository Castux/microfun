-- bwrite outputs a minimal BMP header
import core, list in
bwrite [
  66; 77; -- BM
  54; 0; 0; 0; -- Size 54
  0; 0; 0; 0; -- Reserved
  54; 0; 0; 0; -- Offset 54
  40; 0; 0; 0; -- Header size 40
  1; 0; 0; 0; -- Width 1
  1; 0; 0; 0; -- Height 1
  1; 0; -- Planes 1
  24; 0; -- BitCount 24
  0; 0; 0; 0; -- Compression 0
  0; 0; 0; 0; -- ImageSize 0
  0; 0; 0; 0; -- XPels 0
  0; 0; 0; 0; -- YPels 0
  0; 0; 0; 0; -- Colors 0
  0; 0; 0; 0 -- Important 0
]
