-- List patterns (normalized to nested cons patterns by the analyzer). A trailing
-- ';' marks a one-element list; two-or-more elements need no trailing ';'.
import core, list in
let describe = {
  [] -> 0,
  [x;] -> 1,
  [x; y] -> 2,
  rest -> 99
} in
show [describe []; describe [7;]; describe [7; 8]; describe [7; 8; 9]]
